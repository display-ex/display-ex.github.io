<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0f1724"/>
      <stop offset="100%" stop-color="#071427"/>
    </linearGradient>
    <linearGradient id="badge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0ea5e9"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="12" flood-color="#000" flood-opacity="0.45"/>
    </filter>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Decorative grid lines -->
  <g opacity="0.08" stroke="#9aa6b2" stroke-width="1">
    <path d="M0 90H1200M0 180H1200M0 270H1200M0 360H1200M0 450H1200M0 540H1200"/>
    <path d="M200 0V630M400 0V630M600 0V630M800 0V630M1000 0V630"/>
  </g>

  <!-- Badge -->
  <g transform="translate(80,120)">
    <rect width="110" height="110" rx="16" fill="url(#badge)" filter="url(#shadow)"/>
    <text x="55" y="70" text-anchor="middle" font-family="Inter,Segoe UI,Roboto,Arial" font-size="44" font-weight="800" fill="#042331">EX</text>
  </g>

  <!-- Title and subtitle -->
  <g transform="translate(220,160)">
    <text font-family="Inter,Segoe UI,Roboto,Arial" font-size="60" font-weight="800" fill="#ffffff">Display EX for Windows</text>
    <text y="64" font-family="Inter,Segoe UI,Roboto,Arial" font-size="28" fill="#9aa6b2">Advanced display profiles • Multi‑monitor • DPI • HDR • 144 Hz</text>
  </g>

  <!-- CTA pill -->
  <g transform="translate(220,300)">
    <rect x="0" y="-44" width="640" height="88" rx="44" fill="#0ea5e9" filter="url(#shadow)"/>
    <text x="320" y="12" text-anchor="middle" font-family="Inter,Segoe UI,Roboto,Arial" font-size="30" font-weight="800" fill="#042331">Download for Windows 11/10 (64‑bit)</text>
  </g>

  <!-- File line -->
  <g transform="translate(220,390)" opacity="0.9">
    <text font-family="Inter,Segoe UI,Roboto,Arial" font-size="20" fill="#9aa6b2">Official installer: https://www.cdisplayex.com/files/CDXWin64v1.10.33.exe</text>
  </g>

  <!-- Footer note -->
  <g transform="translate(80,560)" opacity="0.9">
    <text font-family="Inter,Segoe UI,Roboto,Arial" font-size="18" fill="#9aa6b2">Code‑signed • High contrast • AI‑friendly landing</text>
  </g>
</svg>
